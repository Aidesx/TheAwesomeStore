@using Project_385.Models
@using Project_385.Models.ViewModels
@model ProductDetailViewModels
@{
    var relatedByCategory = ViewBag.RelatedByCategory as List<ProductModels> ?? new List<ProductModels>();
    var relatedByBrand = ViewBag.RelatedByBrand as List<ProductModels> ?? new List<ProductModels>();
    var recommendedProducts = relatedByBrand.Any() ? relatedByBrand : relatedByCategory;
}

<link rel="stylesheet" href="~/css/product_detail.css" />

<div class="row">
    <div class="col-sm-3">
        <partial name="_Sidebar" />
    </div>

    <div class="col-sm-9">
        <div class="product-details animate-fade-in-up">
            <div class="product-main">
                <div class="product-img-box img-zoom-container">
                    <img src="~/images/@Model.Product.Image" alt="@Model.Product.Name" onerror="this.onerror=null;this.src='/images/default.png';" />
                </div>

                <div class="product-info-box">
                    <h2>@Model.Product.Name</h2>

                    <div class="price-section">
                        <span class="price-current">@Model.Product.Price.ToString("N0") đ</span>
                    </div>

                    <div class="quantity-box">
                        <label for="product-quantity">Số lượng:</label>
                        <input id="product-quantity" type="number" value="1" min="1" max="@Math.Min(100, Model.Product.StockQuantity)" inputmode="numeric" class="form-control" disabled="@(Model.Product.StockQuantity <= 0)" aria-describedby="product-stock-status" />
                    </div>

                    <div class="product-action-group">
                        <button type="button" class="btn-add-cart add-to-cart" data-product-id="@Model.Product.Id" disabled="@(Model.Product.StockQuantity <= 0)">
                            <i class="fa fa-shopping-cart"></i> Thêm vào giỏ
                        </button>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <button type="button" class="btn-wishlist add-btn-wishlist" data-product-id="@Model.Product.Id">
                                <i class="fa fa-heart"></i> Yêu thích
                            </button>
                            <button type="button" class="btn-compare add-btn-compare" data-product-id="@Model.Product.Id">
                                <i class="fa fa-exchange"></i> So sánh
                            </button>
                        }
                    </div>

                    <div class="meta-info">
                        <p id="product-stock-status"><b>Tồn kho:</b> <span>@(Model.Product.StockQuantity > 0 ? $"Còn {Model.Product.StockQuantity} sản phẩm" : "Hiện đã hết hàng. Vui lòng liên hệ cửa hàng để được hỗ trợ.")</span></p>
                        <p><b>Tình trạng:</b> <span>Mới</span></p>
                        <p><b>Thương hiệu:</b> <span>@Model.Product.Brand.Name</span></p>
                        <p><b>Danh mục:</b> <span>@Model.Product.Category.Name</span></p>
                    </div>

                    <div class="share-row" style="margin-top: 1.25rem; display: flex; align-items: center; gap: 0.75rem; color: #94a3b8; font-size: 0.9rem;">
                        <span>Chia sẻ:</span>
                        <button type="button" class="btn-copy-product-link" id="copy-product-link">Sao chép liên kết</button>
                        <span id="copy-product-link-status" role="status" aria-live="polite"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="category-tab shop-details-tab">
            <div class="col-sm-12">
                <ul class="nav nav-tabs">
                    <li><a href="#details" data-toggle="tab">Mô tả</a></li>
                    <li><a href="#companyprofile" data-toggle="tab">Cùng thương hiệu</a></li>
                    <li><a href="#tag" data-toggle="tab">Cùng danh mục</a></li>
                    <li class="active"><a href="#reviews" data-toggle="tab">Đánh giá (@Model.Ratings.Count)</a></li>
                </ul>
            </div>

            <div class="tab-content">
                <div class="tab-pane fade" id="details">
                    <div class="col-sm-12">
                        @Html.Raw(Model.Product.Description)
                    </div>
                </div>

                <div class="tab-pane fade" id="companyprofile">
                    <div class="mini-product-grid">
                        @foreach (var related in relatedByBrand)
                        {
                            <div class="mini-product-card">
                                <a asp-action="Details" asp-controller="Product" asp-route-id="@related.Id">
                                    <img loading="lazy" decoding="async" src="~/images/@related.Image" alt="@related.Name" />
                                </a>
                                <div class="caption">
                                    <h5>@related.Name</h5>
                                    <div class="price">@related.Price.ToString("N0") đ</div>
                                    <button type="button" class="btn-add-cart add-to-cart" data-product-id="@related.Id" disabled="@(related.StockQuantity <= 0)">
                                        <i class="fa fa-shopping-cart"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="tag">
                    <div class="mini-product-grid">
                        @foreach (var related in relatedByCategory)
                        {
                            <div class="mini-product-card">
                                <a asp-action="Details" asp-controller="Product" asp-route-id="@related.Id">
                                    <img loading="lazy" decoding="async" src="~/images/@related.Image" alt="@related.Name" />
                                </a>
                                <div class="caption">
                                    <h5>@related.Name</h5>
                                    <div class="price">@related.Price.ToString("N0") đ</div>
                                    <button type="button" class="btn-add-cart add-to-cart" data-product-id="@related.Id" disabled="@(related.StockQuantity <= 0)">
                                        <i class="fa fa-shopping-cart"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade active in" id="reviews">
                    <div class="col-sm-12">
                        @if (Model.Ratings != null && Model.Ratings.Any())
                        {
                            foreach (var review in Model.Ratings)
                            {
                                <div class="review-item">
                                    <div class="review-header">
                                        <strong><i class="fa fa-user"></i> @review.Name</strong>
                                        <span class="review-email"><i class="fa fa-envelope"></i> @review.Email</span>
                                    </div>
                                    <div class="star-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (int.TryParse(review.Rating, out int rVal) && i <= rVal)
                                            {
                                                <i class="fa fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-star-o"></i>
                                            }
                                        }
                                    </div>
                                    <p>@review.Comment</p>
                                </div>
                            }
                        }

                        <p class="review-title"><b>Viết đánh giá của bạn</b></p>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (ViewBag.HasReviewed)
                            {
                                <div class="alert alert-info ui-alert">
                                    Bạn đã gửi đánh giá cho sản phẩm này. Mỗi tài khoản chỉ được đánh giá một lần.
                                </div>
                            }
                            else
                            {
                                <form autocomplete="off" asp-action="CommentProduct" asp-controller="Product" method="post" class="review-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="Rating.ProductId" value="@Model.Product.Id" />

                                    <div class="form-group">
                                        <label asp-for="Rating.Name">Tên</label>
                                        <input asp-for="Rating.Name" type="text" value="@ViewBag.UserName" readonly class="form-control" />
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="Rating.Email">Email</label>
                                        <input asp-for="Rating.Email" type="email" value="@ViewBag.UserEmail" readonly class="form-control" />
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="Rating.Comment">Bình luận</label>
                                        <textarea asp-for="Rating.Comment" class="form-control" rows="4" placeholder="Viết cảm nghĩ của bạn..."></textarea>
                                        <span asp-validation-for="Rating.Comment" class="text-danger"></span>
                                    </div>

                                    <fieldset class="rating-row star-picker-group">
                                        <legend>Đánh giá</legend>
                                        <div id="star-rating" class="star-picker" role="radiogroup" aria-label="Chọn số sao">
                                            @for (var score = 1; score <= 5; score++)
                                            {
                                                <input class="visually-hidden star-radio" type="radio" name="Rating.Rating" id="rating-@score" value="@score" checked="@(score == 5)" />
                                                <label for="rating-@score" aria-label="@score sao"><i class="fa fa-star" aria-hidden="true"></i></label>
                                            }
                                        </div>
                                    </fieldset>

                                    <button type="submit" class="btn-submit-review">Gửi đánh giá</button>
                                </form>
                            }
                        }
                        else
                        {
                            <div class="review-login-prompt" style="padding: 1.5rem; background: rgba(30, 41, 59, 0.4); border: 1px dashed #334155; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
                                <div style="display: flex; align-items: center; gap: 0.75rem; color: #cbd5e1;">
                                    <i class="fa fa-lock" style="font-size: 1.25rem; color: #f59e0b;"></i>
                                    <span>Bạn cần đăng nhập để viết cảm nhận và chấm sao cho sản phẩm này.</span>
                                </div>
                                <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary" style="background: linear-gradient(135deg, #2563eb, #3b82f6); border: none; border-radius: 8px; padding: 0.55rem 1.25rem; font-weight: 600; color: #fff; text-decoration: none;">
                                    <i class="fa fa-sign-in"></i> Đăng nhập ngay
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (recommendedProducts != null && recommendedProducts.Any())
        {
            <div class="recommended_items">
                <h2><i class="fa fa-star"></i> Sản phẩm đề xuất</h2>
                <div id="recommended-item-carousel" class="carousel slide">
                    <div class="carousel-inner">
                        @{
                            int recCount = 0;
                            foreach (var related in recommendedProducts)
                            {
                                if (recCount % 3 == 0)
                                {
                                    string activeClass = recCount == 0 ? "active" : "";
                                    @Html.Raw($"<div class=\"item {activeClass}\"><div class=\"row\">")
                                }

                                <div class="col-sm-4">
                                    <div class="mini-product-card compact">
                                        <a asp-action="Details" asp-controller="Product" asp-route-id="@related.Id">
                                            <img loading="lazy" decoding="async" src="~/images/@related.Image" alt="@related.Name" onerror="this.onerror=null;this.src='/images/default.png';" />
                                        </a>
                                        <div class="caption">
                                            <h5>@related.Name</h5>
                                            <div class="price">@related.Price.ToString("N0") đ</div>
                                            <button type="button" class="btn-add-cart add-to-cart" data-product-id="@related.Id" disabled="@(related.StockQuantity <= 0)">
                                                <i class="fa fa-shopping-cart"></i> Thêm
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                if (recCount % 3 == 2 || recCount == recommendedProducts.Count - 1)
                                {
                                    @Html.Raw("</div></div>")
                                }
                                recCount++;
                            }
                        }
                    </div>
                    @if (recommendedProducts.Count > 3)
                    {
                        <a class="left carousel-control" href="#recommended-item-carousel" data-slide="prev" aria-label="Sản phẩm đề xuất trước">
                            <i class="fa fa-angle-left" aria-hidden="true"></i>
                        </a>
                        <a class="right carousel-control" href="#recommended-item-carousel" data-slide="next" aria-label="Sản phẩm đề xuất tiếp theo">
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#copy-product-link').on('click', async function () {
                var status = document.getElementById('copy-product-link-status');
                try {
                    await navigator.clipboard.writeText(window.location.href);
                    if (status) status.textContent = 'Đã sao chép liên kết sản phẩm.';
                } catch (error) {
                    if (status) status.textContent = 'Trình duyệt không cho phép sao chép liên kết.';
                }
            });

            $('#star-rating input').on('change', function () {
                var selectedValue = Number(this.value);
                $('#star-rating').attr('aria-label', `Đã chọn ${selectedValue} trên 5 sao`);
                $('#star-rating label i').each(function (index) {
                    $(this).toggleClass('fa-star', index < selectedValue).toggleClass('fa-star-o', index >= selectedValue);
                });
            });

            $(document).on('click', '.add-to-cart', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("Add", "Cart")',
                    type: 'POST',
                    data: { Id: id, quantity: $(this).closest('.product-info-box').length ? Math.max(1, Math.min(100, parseInt($('#product-quantity').val(), 10) || 1)) : 1 },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: result.message || 'Đã thêm vào giỏ hàng!',
                                background: '#0d1117',
                                color: '#e2e8f0',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: xhr.responseJSON?.message || 'Có lỗi xảy ra',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });

            $(document).on('click', '.add-btn-wishlist', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddWishList", "Home")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã thêm vào yêu thích',
                                showConfirmButton: false,
                                timer: 1500,
                                background: '#0d1117',
                                color: '#e2e8f0'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể thêm yêu thích',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });

            $(document).on('click', '.add-btn-compare', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddCompare", "Home")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã thêm vào so sánh',
                                showConfirmButton: false,
                                timer: 1500,
                                background: '#0d1117',
                                color: '#e2e8f0'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể thêm so sánh',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });
        });

        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');

        function showSlide(index) {
            if (slides.length === 0) return;
            $('.hero-slide').removeClass('active');
            $(slides[index]).addClass('active');
            currentSlide = index;
        }

        function changeSlide(dir) {
            showSlide((currentSlide + dir + slides.length) % slides.length);
        }

        if (slides.length > 0) {
            setInterval(() => changeSlide(1), 5000);
        }
    </script>
}
