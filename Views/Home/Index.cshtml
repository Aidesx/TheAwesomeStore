@model IEnumerable<ProductModels>
@{
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}

<link rel="stylesheet" href="~/css/home_index.css" />
<link rel="stylesheet" href="~/css/product_list_base.css" />

<section class="hero-slider" aria-label="Sản phẩm nổi bật" tabindex="0">
    <div class="hero-bg-glow"></div>
    <div class="hero-grid-bg"></div>

    @if (Model != null && Model.Any())
    {
        var sliderItems = Model.Take(3).ToList();
        for (int i = 0; i < sliderItems.Count; i++)
        {
            var item = sliderItems[i];
            <div class="hero-slide @(i == 0 ? "active" : "")" data-slide="@i">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="hero-slide-link" aria-label="@item.Name"></a>

                <div class="hero-content hero-content-layer">
                    <span class="hero-tag">Sản phẩm nổi bật · @(item.StockQuantity > 0 ? $"Còn {item.StockQuantity}" : "Hết hàng")</span>
                    <h1 class="hero-title">@item.Name</h1>
                    <p class="hero-desc">
                        Thương hiệu: @item.Brand?.Name <br />
                        Giá: <span class="hero-price">@item.Price.ToString("#,##0 VND")</span>
                    </p>

                    <div class="hero-action-group">
                        <button type="button" class="add-to-cart btn-primary-hero" data-product-id="@item.Id" disabled="@(item.StockQuantity <= 0)">
                            <i class="fa fa-shopping-cart"></i> Thêm vào giỏ hàng
                        </button>

                        <div class="hero-action-row">
                            <button type="button" class="add-btn-wishlist hero-icon-btn" data-product-id="@item.Id">
                                <i class="fa fa-heart"></i> Yêu thích
                            </button>
                            <button type="button" class="add-btn-compare hero-icon-btn" data-product-id="@item.Id">
                                <i class="fa fa-exchange"></i> So sánh
                            </button>
                        </div>
                    </div>
                </div>

                <div class="hero-img-wrap hero-content-layer">
                    <div class="hero-img-glow"></div>
                    <img loading="@(i == 0 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "auto")" decoding="async" src="~/images/@item.Image" alt="@item.Name" onerror="this.onerror=null;this.src='/images/default.png';" />
                </div>
            </div>
        }
    }

    @if (Model != null && Model.Skip(1).Any())
    {
        <button class="hero-nav hero-prev" type="button" aria-label="Sản phẩm trước" onclick="changeSlide(-1)"><i aria-hidden="true" class="fa fa-chevron-left"></i></button>
        <button class="hero-nav hero-next" type="button" aria-label="Sản phẩm tiếp theo" onclick="changeSlide(1)"><i aria-hidden="true" class="fa fa-chevron-right"></i></button>
        <button class="hero-nav hero-pause" type="button" aria-label="Tạm dừng tự chuyển" aria-pressed="false"><i class="fa fa-pause" aria-hidden="true"></i></button>
    }
</section>

<section class="services-bar">
    <div class="services-container">
        <div class="service-item"><div class="service-icon"><i class="fa fa-truck"></i></div><div><p>Phí di chuyển minh bạch</p></div></div>
        <div class="service-item"><div class="service-icon"><i class="fa fa-shield"></i></div><div><p>Bảo Hành Uy Tín</p></div></div>
        <div class="service-item"><div class="service-icon"><i class="fa fa-refresh"></i></div><div><p>Đổi Trả Dễ Dàng</p></div></div>
    </div>
</section>

<section class="main-content">
    <div class="main-flex">
        
        <aside class="sidebar-col">
            <partial name="_Sidebar" />
        </aside>

        <div class="products-col">
            <div class="product-grid">
                @foreach (var item in Model)
                {
                    <div class="product-card animate-fade-in-up">
                        <a asp-action="Details" asp-controller="Product" asp-route-id="@item.Id" class="product-link">
                            <div class="product-img img-zoom-container">
                                <img loading="lazy" decoding="async" src="~/images/@item.Image" alt="@item.Name" onerror="this.onerror=null;this.src='/images/default.png';" />
                            </div>      
                        </a>
                        <a asp-action="Details" asp-controller="Product" asp-route-id="@item.Id" class="card-title">
                            @item.Name
                        </a>

                        <div class="card-body">
                            <p class="card-details">Danh mục: @item.Category?.Name</p>
                            <p class="card-details">Thương hiệu: @item.Brand?.Name</p>
                            <p class="card-details stock-status">@(item.StockQuantity > 0 ? $"Còn {item.StockQuantity} sản phẩm" : "Hết hàng")</p>

                            <div class="card-price-row">
                                <div>
                                    <p class="price-current">@item.Price.ToString("#,##0 VND")</p>
                                </div>
                                <button type="button" class="btn-add-cart add-to-cart" data-product-id="@item.Id" disabled="@(item.StockQuantity <= 0)" aria-label="@(item.StockQuantity > 0 ? $"Thêm {item.Name} vào giỏ hàng" : $"{item.Name} đã hết hàng")">
                                    <i class="fa fa-shopping-cart"></i> Thêm
                                </button>
                            </div>

                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <div class="card-actions">
                                    <button type="button" class="btn-wishlist add-btn-wishlist" data-product-id="@item.Id">
                                        <i class="fa fa-plus-square"></i> Yêu thích
                                    </button>
                                    <button type="button" class="btn-compare add-btn-compare" data-product-id="@item.Id">
                                        <i class="fa fa-plus-square"></i> So sánh
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (pager != null && pager.TotalPage > 1)
            {
                <div class="pagination-wrapper tailwind-pagination">
                    <ul class="pagination-container" role="navigation" aria-label="Phân trang">
                        @if (pager.CurrentPage > 1)
                        {
                            <li class="page-item"><a asp-action="Index" asp-route-pg="1" class="page-link">Đầu</a></li>
                            <li class="page-item"><a asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)" class="page-link">Trước</a></li>
                        }

                        @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
                        {
                            <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                                <a asp-action="Index" asp-route-pg="@pge" class="page-link" aria-current="@(pge == pager.CurrentPage ? "page" : null)">@pge</a>
                            </li>
                        }

                        @if (pager.CurrentPage < pager.TotalPage)
                        {
                            <li class="page-item"><a asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)" class="page-link">Tiếp</a></li>
                            <li class="page-item"><a asp-action="Index" asp-route-pg="@(pager.TotalPage)" class="page-link">Cuối</a></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(document).on('click', '.add-to-cart, .add-btn-wishlist, .add-btn-compare', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var $btn = $(this);
                var id = $btn.data('product-id');
                var url = '';
                var msg = '';

                if ($btn.hasClass('add-to-cart')) {
                    url = '@Url.Action("Add", "Cart")';
                    msg = 'Đã thêm sản phẩm vào giỏ hàng!';
                } else if ($btn.hasClass('add-btn-wishlist')) {
                    url = '@Url.Action("AddWishList", "Home")';
                    msg = 'Đã thêm vào yêu thích!';
                } else {
                    url = '@Url.Action("AddCompare", "Home")';
                    msg = 'Đã thêm vào so sánh!';
                }

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { Id: id, quantity: 1 },
                    success: function (r) {
                        if (r.success === true) {
                            Swal.fire({
                                icon: 'success',
                                title: r.message || msg,
                                showConfirmButton: false,
                                timer: 1500,
                                background: '#0d1117',
                                color: '#e2e8f0'
                            });
                        }
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại!',
                            text: xhr.responseJSON?.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });
        });

        (() => {
            const root = document.querySelector('.hero-slider');
            const slides = [...document.querySelectorAll('.hero-slide')];
            if (!root || slides.length < 2) return;
            const pauseButton = root.querySelector('.hero-pause');
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            let currentSlide = Math.max(0, slides.findIndex(slide => slide.classList.contains('active')));
            let timer = null;
            let userPaused = false;
            let interacting = false;
            const showSlide = index => {
                slides[currentSlide].classList.remove('active');
                currentSlide = (index + slides.length) % slides.length;
                slides[currentSlide].classList.add('active');
            };
            const changeSlide = direction => showSlide(currentSlide + direction);
            window.changeSlide = changeSlide;
            const stop = () => { if (timer) window.clearInterval(timer); timer = null; };
            const start = () => {
                stop();
                if (!userPaused && !interacting && !reducedMotion.matches) timer = window.setInterval(() => changeSlide(1), 6000);
            };
            pauseButton?.addEventListener('click', () => {
                userPaused = !userPaused;
                pauseButton.setAttribute('aria-pressed', String(userPaused));
                pauseButton.setAttribute('aria-label', userPaused ? 'Tiếp tục tự chuyển' : 'Tạm dừng tự chuyển');
                pauseButton.innerHTML = `<i class="fa ${userPaused ? 'fa-play' : 'fa-pause'}" aria-hidden="true"></i>`;
                start();
            });
            root.addEventListener('mouseenter', () => { interacting = true; stop(); });
            root.addEventListener('mouseleave', () => { interacting = false; start(); });
            root.addEventListener('focusin', () => { interacting = true; stop(); });
            root.addEventListener('focusout', event => {
                if (!root.contains(event.relatedTarget)) { interacting = false; start(); }
            });
            reducedMotion.addEventListener?.('change', start);
            start();
        })();
    </script>
}
