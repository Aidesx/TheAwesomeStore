@model Project_385.Models.ViewModels.LoginViewModels
@{
    ViewData["Title"] = "Đăng nhập";
}

<link rel="stylesheet" href="~/css/account_login.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="page-shell narrow">
<div class="login-card page-card">
    <h2><i class="fa fa-lock"></i> @ViewData["Title"]</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" aria-live="assertive"></div>

    <form asp-action="Login" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="form-group">
            <label asp-for="UserName">Tên đăng nhập</label>
            <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập..." />
            <span asp-validation-for="UserName" class="text-danger" aria-live="polite"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." id="passwordInput" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger" aria-live="polite"></span>
        </div>

        <div class="auth-checkbox-row">
            <label for="showPassword">
                <input type="checkbox" id="showPassword" onclick="togglePassword()" />
                <span>Hiển thị mật khẩu</span>
            </label>
        </div>
        <div class="auth-checkbox-row">
            <label asp-for="RememberMe">
                <input asp-for="RememberMe" type="checkbox" />
                <span>Ghi nhớ đăng nhập</span>
            </label>
        </div>
        <div class="button-group">
            <button type="submit" class="btn-login"><i class="fa fa-sign-in"></i> Đăng nhập</button>
            <a asp-action="Create" asp-controller="Account" class="btn-register"><i class="fa fa-user-plus"></i> Đăng ký</a>
        </div>

        <hr class="auth-divider" />

        <a asp-action="LoginGoogle" asp-controller="Account"
           asp-route-returnUrl="@ViewData["ReturnUrl"]"
           class="btn-danger">
            <i class="fa-brands fa-google"></i> Đăng nhập bằng Google
        </a>
    </form>

    <div class="forgot-section">
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <label class="auth-forgot-heading">Quên mật khẩu?</label>
            <div class="auth-forgot-section">
                <label class="sr-only" for="login-forgot-email">Email khôi phục</label>
                <input type="email" id="login-forgot-email" name="Email" autocomplete="email" class="form-control auth-forgot-input" placeholder="Nhập email để lấy lại mật khẩu" required />
                <button type="submit" class="btn-forgot"><i class="fa fa-envelope"></i> Gửi</button>
            </div>
        </form>
    </div>
</div>
</div>

<script>
    function togglePassword() {
        var input = document.getElementById("passwordInput");
        input.type = input.type === "password" ? "text" : "password";
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
